# Required: create this secret at https://resend.com/api-keys
RESEND_API_KEY=re_your_private_api_key

# Public canonical URL used for production references and analytics setup.
NEXT_PUBLIC_SITE_URL=https://www.mateordgz.dev

# Optional after verifying a sending domain in Resend.
CONTACT_FROM_EMAIL=MR14 Portfolio <contacto@mateordgz.dev>

# Required for the inline Cal.com booking calendar.
# Use only the path after cal.com.
NEXT_PUBLIC_CAL_LINK=mateo-rodriguez-qpbrnc/portfolio

# Optional: paste the verification token supplied by Google Search Console.
# GOOGLE_SITE_VERIFICATION=your_search_console_token

# Google Analytics 4 measurement ID. It is public and may be overridden per environment.
NEXT_PUBLIC_GA_ID=G-2EQ71K5M2F

# Meta (Facebook) Pixel ID. It is public and may be overridden per environment.
NEXT_PUBLIC_META_PIXEL_ID=1776448393706274
